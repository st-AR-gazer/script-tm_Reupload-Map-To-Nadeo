    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ReuploadMapToNadeo</AssemblyName>
    <RootNamespace>ReuploadMapToNadeo</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GBX.NET" Version="2.4.4" />
    <PackageReference Include="GBX.NET.LZO" Version="2.1.6" />
    <PackageReference Include="ManiaAPI.NadeoAPI" Version="2.9.4" />
    <PackageReference Include="ManiaAPI.NadeoAPI.Extensions.Gbx" Version="2.8.5" />
  </ItemGroup>

</Project>
